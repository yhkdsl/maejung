<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 조회 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 마중: 위치 중계 서버 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 마중: 차 위치, 음성 승인 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 마중: 다른 앱 위에 뜨는 픽업 요청 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 마중: 화면 뒤에서도 요청 수신·위치 전송·탑승 감지 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 에뮬레이터에 안드로이드 기본 TTS 엔진이 없어 Pleos TTS(ON_DEVICE)를 쓴다 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 음성 승인. 안드로이드 SpeechRecognizer는 에뮬레이터에서 응답이 없어 Pleos STT(ON_DEVICE)를 쓴다 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- 마중: 탑승자 위치까지 경로·도착 예정 시간 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 제어. 공조·창문은 스파이크 검증 기록에서만 쓴다. 릴리스(D3) 전에 정리한다 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- 실내등 차 찾기. 문서에는 set에 CAR_LIGHTS만 적혀 있지만 실제로는 제어 퍼미션이 필요하다 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />

    <application
        android:name=".MaejungApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 화면을 띄울 수 있게 하는 AAOS 설정 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SDK 검증 기록. 런처에는 없고 adb로만 연다:
             adb shell am start -n com.maejung/.spike.VehicleSpikeActivity -->
        <activity
            android:name=".spike.VehicleSpikeActivity"
            android:exported="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <receiver
            android:name=".spike.PickupAlertReceiver"
            android:exported="false" />

        <receiver
            android:name=".alert.PickupAlertReceiver"
            android:exported="false" />

        <service
            android:name=".service.CarSessionService"
            android:exported="false"
            android:foregroundServiceType="location|microphone" />
    </application>
</manifest>
